# Preserve verified hashes of domain rules and capability packages.
# Line-ending normalization would invalidate the byte-pinned framework and snapshots.
/aiotbot-knowledge-wifi-mp/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/config.yml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/AGENTS.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/skills/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/workflows/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Shell entries must also work after a Windows checkout is copied to Linux.
/install.sh text eol=lf
/install.ps1 text eol=crlf

# Preserve approved design bytes.
/aiotbot-knowledge-wifi-mp/docs-llm-wiki/AIoTBot知识库架构设计.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
