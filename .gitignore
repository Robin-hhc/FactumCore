# Local development state; outside the versioned section 5.3 layout.
/.worktrees/
/.scratch/
/analysis/
/artifacts/
/.cac/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
config.local.yml

# Business sources are registered separately; keep the slot only.
/main/*
!/main/.gitkeep
**/.codegraph/

# Domain runtime products: publish empty slots, never generated contents.
/aiotbot-knowledge/*/.build/*
!/aiotbot-knowledge/*/.build/.gitkeep
/aiotbot-knowledge/*/artifacts/*
!/aiotbot-knowledge/*/artifacts/.gitkeep

# Retired independent checkout, if still present locally.
/aiot-knowledge/
