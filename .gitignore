# Local development state; outside the versioned section 5.3 layout.
/.worktrees/
/.scratch/
/analysis/
/artifacts/
/.cac/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
config.local.yml
# Manifest-root instructions are maintained by the project.
# This checkout keeps its manifest-root instructions locally.
/AGENTS.md
# Machine-owned environment files stay private.
*.env

# Project development artifacts stay local; shared design and usage remain versioned.
/himate/himate-knowledge-wifi-mp/docs-llm-wiki/sdd/
/himate/himate-knowledge-wifi-mp/docs-llm-wiki/task.md

# Business sources are registered separately; keep the explanatory README only.
/main/*
!/main/README.md
**/.codegraph/

# Raw business material stays local; publish each directory's README only.
/himate/himate-knowledge-wifi-mp/docs-raw/agent-notes/*
!/himate/himate-knowledge-wifi-mp/docs-raw/agent-notes/README.md
/himate/himate-knowledge-wifi-mp/docs-raw/chips/*
!/himate/himate-knowledge-wifi-mp/docs-raw/chips/README.md
/himate/himate-knowledge-wifi-mp/docs-raw/conventions/*
!/himate/himate-knowledge-wifi-mp/docs-raw/conventions/README.md
/himate/himate-knowledge-wifi-mp/docs-raw/protocols/*
!/himate/himate-knowledge-wifi-mp/docs-raw/protocols/README.md
/himate/himate-knowledge-wifi-mp/docs-raw/sources/3ms/*
!/himate/himate-knowledge-wifi-mp/docs-raw/sources/3ms/README.md
/himate/himate-knowledge-wifi-mp/docs-raw/sources/dbox/*
!/himate/himate-knowledge-wifi-mp/docs-raw/sources/dbox/README.md
/himate/himate-knowledge-wifi-mp/docs-raw/sources/wiki/*
!/himate/himate-knowledge-wifi-mp/docs-raw/sources/wiki/README.md
/himate/himate-knowledge-wifi-mp/docs-raw/specs/*
!/himate/himate-knowledge-wifi-mp/docs-raw/specs/README.md
/himate/himate-knowledge-wifi-mp/docs-raw/storys/*
!/himate/himate-knowledge-wifi-mp/docs-raw/storys/README.md
/himate/himate-knowledge-wifi-mp/docs-raw/troubleshooting/*
!/himate/himate-knowledge-wifi-mp/docs-raw/troubleshooting/README.md

# Domain runtime products: publish explanatory READMEs, never generated contents.
/himate/himate-knowledge-wifi-mp/.build/*
!/himate/himate-knowledge-wifi-mp/.build/README.md
/himate/himate-knowledge-wifi-mp/artifacts/*
!/himate/himate-knowledge-wifi-mp/artifacts/README.md

# Retain historical evidence paths; new receipts live under artifacts/.
# Historical source caches and local operation records stay private.
/himate/himate-knowledge-wifi-mp/logs/ingest/
/himate/himate-knowledge-wifi-mp/logs/evidence/objects/
/himate/himate-knowledge-wifi-mp/logs/evidence/checked-code/
