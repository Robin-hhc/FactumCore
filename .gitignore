# Local development state; outside the versioned section 5.3 layout.
/.worktrees/
/.scratch/
/analysis/
/artifacts/
/.cac/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
config.local.yml
# Machine-owned execution connection data. The distributable template remains tracked.
config.env

# Project development artifacts stay local; shared design and usage remain versioned.
/aiotbot-knowledge-wifi-mp/docs-llm-wiki/sdd/
/aiotbot-knowledge-wifi-mp/docs-llm-wiki/task.md

# Business sources are registered separately; keep the slot only.
/main/*
!/main/.gitkeep
**/.codegraph/

# Domain runtime products: publish empty slots, never generated contents.
/aiotbot-knowledge-wifi-mp/.build/*
!/aiotbot-knowledge-wifi-mp/.build/.gitkeep
/aiotbot-knowledge-wifi-mp/artifacts/*
!/aiotbot-knowledge-wifi-mp/artifacts/.gitkeep

# Keep audit metadata versionable; never publish copied original/code bytes or writer state.
/aiotbot-knowledge-wifi-mp/logs/evidence/objects/
/aiotbot-knowledge-wifi-mp/logs/evidence/checked-code/
/aiotbot-knowledge-wifi-mp/logs/operations/.writer.lock
/aiotbot-knowledge-wifi-mp/logs/operations/*/backups/

# Retired independent checkout, if still present locally.
/aiot-knowledge/
