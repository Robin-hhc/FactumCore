# Local development state; outside the versioned section 5.3 layout.
/.worktrees/
/.scratch/
/analysis/
/artifacts/
/.cac/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
config.local.yml

# Business sources are registered separately; keep the slot only.
/main/*
!/main/.gitkeep
**/.codegraph/

# Domain runtime products: publish empty slots, never generated contents.
/aiotbot-knowledge-wifi/.build/*
!/aiotbot-knowledge-wifi/.build/.gitkeep
/aiotbot-knowledge-wifi/artifacts/*
!/aiotbot-knowledge-wifi/artifacts/.gitkeep

# Keep audit metadata versionable; never publish copied original/code bytes or writer state.
/aiotbot-knowledge-wifi/logs/evidence/objects/
/aiotbot-knowledge-wifi/logs/evidence/checked-code/
/aiotbot-knowledge-wifi/logs/operations/.writer.lock
/aiotbot-knowledge-wifi/logs/operations/*/backups/

# Retired independent checkout, if still present locally.
/aiot-knowledge/
