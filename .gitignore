# Local development state; outside the versioned section 5.3 layout.
/.worktrees/
/.scratch/
/analysis/
/artifacts/
/.cac/
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
config.local.yml
# This development checkout keeps its own Agent instructions locally.
# Merge the tracked AGENTS.md.example into the real business repository's AGENTS.md.
/AGENTS.md
# Machine-owned environment files stay private.
*.env

# Project development artifacts stay local; shared design and usage remain versioned.
/himate/himate-knowledge-wifi-mp/docs-llm-wiki/sdd/
/himate/himate-knowledge-wifi-mp/docs-llm-wiki/task.md

# Business sources are registered separately; keep the slot only.
/main/*
!/main/.gitkeep
**/.codegraph/

# Domain runtime products: publish empty slots, never generated contents.
/himate/himate-knowledge-wifi-mp/.build/*
!/himate/himate-knowledge-wifi-mp/.build/.gitkeep
/himate/himate-knowledge-wifi-mp/artifacts/*
!/himate/himate-knowledge-wifi-mp/artifacts/.gitkeep

# Keep ingest records, applicability events and explicit verification materials
# versionable; copied source caches and machine transaction state stay local.
/himate/himate-knowledge-wifi-mp/logs/evidence/objects/
/himate/himate-knowledge-wifi-mp/logs/evidence/checked-code/
/himate/himate-knowledge-wifi-mp/logs/evidence/extractions/
/himate/himate-knowledge-wifi-mp/logs/evidence/locators/
/himate/himate-knowledge-wifi-mp/logs/operations/*
!/himate/himate-knowledge-wifi-mp/logs/operations/.gitkeep
/himate/himate-knowledge-wifi-mp/logs/patrol/

# Retired independent checkout, if still present locally.
/aiot-knowledge/
