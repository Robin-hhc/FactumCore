{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIoT WiFi Workspace v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "knowledge_roots": {
      "type": "object",
      "properties": {
        "wifi": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "wifi"
      ],
      "additionalProperties": false
    },
    "repos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/repo"
      }
    },
    "architecture": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "wiki_entities": {
      "type": "object"
    },
    "symbol_aliases": {
      "type": "object"
    },
    "targets": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "pairs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/pair"
      }
    },
    "query": {
      "type": "object",
      "properties": {
        "default_channel": {
          "enum": [
            "local",
            "shared"
          ]
        },
        "allowed_channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "local",
              "shared"
            ]
          }
        }
      },
      "required": [
        "default_channel",
        "allowed_channels"
      ],
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": true
    },
    "code_policy": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "schema_version",
    "workspace_id",
    "knowledge_roots",
    "repos",
    "architecture",
    "wiki_entities",
    "symbol_aliases",
    "targets",
    "pairs",
    "query"
  ],
  "additionalProperties": false,
  "$defs": {
    "repo": {
      "type": "object",
      "properties": {
        "repo_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "git",
            "export"
          ]
        },
        "root": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_identity": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "repo_id",
        "kind",
        "root",
        "expected_identity"
      ],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "properties": {
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "repo_id": {
          "type": "string",
          "minLength": 1
        },
        "module_root": {
          "type": "string",
          "minLength": 1
        },
        "knowledge_domain": {
          "const": "wifi"
        },
        "override_nested": {
          "type": "boolean"
        }
      },
      "required": [
        "binding_id",
        "repo_id",
        "module_root",
        "knowledge_domain",
        "override_nested"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "target_id": {
          "enum": [
            "chip12-host",
            "chip12-device",
            "chip08-host",
            "chip08-device",
            "chip07c-host",
            "chip07c-device"
          ]
        },
        "chip": {
          "enum": [
            "chip12",
            "chip08",
            "chip07c"
          ]
        },
        "side": {
          "enum": [
            "host",
            "device"
          ]
        },
        "source_bindings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "module_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "build_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "required_features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protocol_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "target_id",
        "chip",
        "side",
        "source_bindings",
        "module_roots",
        "build_profile",
        "required_features",
        "protocol_versions"
      ],
      "additionalProperties": false
    },
    "pair": {
      "type": "object",
      "properties": {
        "pairing_id": {
          "type": "string",
          "minLength": 1
        },
        "host_target": {
          "type": "string",
          "minLength": 1
        },
        "device_target": {
          "type": "string",
          "minLength": 1
        },
        "compatibility_policy": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "pairing_id",
        "host_target",
        "device_target",
        "compatibility_policy"
      ],
      "additionalProperties": false
    }
  }
}
