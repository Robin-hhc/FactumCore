# Copy to a private config.env and fill actual deployment values.
# This is data, not a shell script. Do not source/eval it.
# Full-line # comments and optional whole-value quotes are supported.
# No variable expansion, command substitution, escapes or inline comments.
# For a server project, run the whole public node and its child CLIs via SSH.
# Keep this file, the caller Python/tools, expected catalog, request and output
# on the caller's own local disk. UNC and Windows network drives are rejected.
# Do not copy the server knowledge root locally to retry a rejected local run.

EXECUTION_MODE=ssh
SSH_HOST=
# Optional: leave blank to use the trusted OpenSSH host configuration.
SSH_USER=
SSH_PORT=
SSH_IDENTITY_FILE=

# Absolute POSIX project root containing the real config.yml on Linux.
REMOTE_PROJECT_ROOT=
# Server-native absolute POSIX catalog path emitted by registration on Linux.
REMOTE_CATALOG=
# Exact remote catalog copy on the caller; local relative paths use this file's directory.
EXPECTED_CATALOG=

# Usually omit: inferred from the matching registered catalog entries.
# REMOTE_PYTHON=
# RULES_DIGEST=

# For a genuinely local independent Windows/Linux deployment only, replace
# the SSH block above with these keys. Shared server workspaces must use SSH.
# Native-looking Linux network mounts are not automatically detected.
# EXECUTION_MODE=local
# PROJECT_ROOT=
# CATALOG=
# Optional exact-root restriction; WiFi root is otherwise read from config.yml.
# KNOWLEDGE_ROOT=
# RULES_DIGEST=
