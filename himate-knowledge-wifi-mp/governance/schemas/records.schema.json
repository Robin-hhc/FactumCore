{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "record_kind"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "record_kind": {
      "enum": [
        "result",
        "project_context",
        "source_bundle",
        "change_plan",
        "final_view",
        "handoff",
        "candidate_inspection",
        "local_check",
        "merge_check",
        "apply_result",
        "transaction_journal",
        "index_manifest",
        "query_regression",
        "search_receipt",
        "maintenance_event",
        "maintenance_state",
        "publish_handoff",
        "recovery_result",
        "source_resolution",
        "workflow_manifest",
        "generation",
        "event",
        "operation_status",
        "semantic_review",
        "artifact_manifest",
        "source_inventory",
        "ingest_record",
        "semantic_plan",
        "content_review",
        "check_report",
        "source_materials",
        "admission_record"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "rules_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tool_identity": {
      "type": "object",
      "required": [
        "skill",
        "package_digest",
        "runtime",
        "requirements_digest"
      ],
      "properties": {
        "skill": {
          "type": "string",
          "pattern": "^hs-"
        },
        "package_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "requirements_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "record_kind": {
            "not": {
              "enum": [
                "result",
                "semantic_review"
              ]
            }
          }
        }
      },
      "then": {
        "required": [
          "operation_id",
          "rules_digest",
          "tool_identity",
          "digest"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "project_context"
          }
        }
      },
      "then": {
        "required": [
          "state",
          "workspace_id",
          "knowledge_root",
          "config_digest",
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array"
          },
          "config_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "source_bundle"
          }
        }
      },
      "then": {
        "required": [
          "resources",
          "snapshots",
          "extractions",
          "limitations"
        ],
        "properties": {
          "resources": {
            "type": "array"
          },
          "snapshots": {
            "type": "array"
          },
          "extractions": {
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "change_plan"
          }
        }
      },
      "then": {
        "required": [
          "bundle_ref",
          "bundle_digest",
          "candidate_ids",
          "decisions",
          "writes",
          "deletes",
          "baseline",
          "review_mode"
        ],
        "properties": {
          "candidate_ids": {
            "type": "array"
          },
          "decisions": {
            "type": "array"
          },
          "writes": {
            "type": "array"
          },
          "deletes": {
            "type": "array"
          },
          "bundle_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "final_view"
          }
        }
      },
      "then": {
        "required": [
          "writes",
          "deletes",
          "baseline_digest",
          "review_mode",
          "plan_ref",
          "plan_digest",
          "source_refs"
        ],
        "properties": {
          "writes": {
            "type": "array"
          },
          "deletes": {
            "type": "array"
          },
          "source_refs": {
            "type": "array"
          },
          "baseline_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "plan_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "handoff"
          }
        }
      },
      "then": {
        "required": [
          "view_ref",
          "view_digest",
          "plan_ref",
          "review_mode",
          "target_workflow"
        ],
        "properties": {
          "view_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "candidate_inspection"
          }
        }
      },
      "then": {
        "required": [
          "view_ref",
          "view_digest",
          "review_mode"
        ],
        "properties": {
          "view_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "local_check"
          }
        }
      },
      "then": {
        "required": [
          "view_ref",
          "view_digest",
          "status",
          "mode",
          "claims"
        ],
        "properties": {
          "claims": {
            "type": "array"
          },
          "view_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "merge_check"
          }
        }
      },
      "then": {
        "required": [
          "view_ref",
          "view_digest",
          "status",
          "mode",
          "claims"
        ],
        "properties": {
          "claims": {
            "type": "array"
          },
          "view_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "apply_result"
          }
        }
      },
      "then": {
        "required": [
          "status",
          "view_ref",
          "view_digest",
          "proof_ref",
          "proof_digest",
          "writes",
          "deletes",
          "verification_tier"
        ],
        "properties": {
          "writes": {
            "type": "array"
          },
          "deletes": {
            "type": "array"
          },
          "view_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "proof_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "transaction_journal"
          }
        }
      },
      "then": {
        "required": [
          "status",
          "view_ref",
          "view_digest",
          "proof_ref",
          "proof_digest",
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array"
          },
          "view_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "proof_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "query_regression"
          }
        }
      },
      "then": {
        "required": [
          "generation_ref",
          "cases_digest",
          "outcomes",
          "passed"
        ],
        "properties": {
          "outcomes": {
            "type": "array"
          },
          "cases_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "search_receipt"
          }
        }
      },
      "then": {
        "required": [
          "generation_ref",
          "generation_id",
          "channel",
          "validity_epoch",
          "evaluation",
          "request_digest",
          "result_digest"
        ],
        "properties": {
          "request_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "result_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "maintenance_event"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "change",
          "affected_claims"
        ],
        "properties": {
          "affected_claims": {
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "maintenance_state"
          }
        }
      },
      "then": {
        "required": [
          "validity_epoch",
          "blocked_claims",
          "impact_scan_watermark",
          "knowledge_apply_watermark"
        ],
        "properties": {
          "blocked_claims": {
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "publish_handoff"
          }
        }
      },
      "then": {
        "required": [
          "status",
          "apply_result_ref",
          "apply_result_digest",
          "view_ref",
          "view_digest",
          "external_obligations",
          "git_merge_verified",
          "remote_push_verified"
        ],
        "properties": {
          "external_obligations": {
            "type": "array"
          },
          "apply_result_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "view_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "recovery_result"
          }
        }
      },
      "then": {
        "required": [
          "mode",
          "status",
          "delegated_result_ref",
          "delegated_result_digest"
        ],
        "properties": {
          "delegated_result_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "workflow_manifest"
          }
        }
      },
      "then": {
        "required": [
          "workflow",
          "phase",
          "request_digest",
          "result_digest"
        ],
        "properties": {
          "request_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "result_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "operation_status"
          }
        }
      },
      "then": {
        "required": [
          "view_ref",
          "view_digest"
        ],
        "properties": {
          "view_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "result"
          }
        }
      },
      "then": {
        "required": [
          "status",
          "phase",
          "data",
          "diagnostics",
          "tool_identity",
          "rules_digest"
        ],
        "properties": {
          "status": {
            "enum": [
              "ok",
              "blocked",
              "error"
            ]
          },
          "data": {
            "type": "object"
          },
          "diagnostics": {
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "index_manifest"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "database_ref",
              "database_digest",
              "documents",
              "qualifications",
              "knowledge_baseline",
              "validity_epoch",
              "channel",
              "generation_id"
            ]
          },
          {
            "required": [
              "generation_ref",
              "generation_id",
              "channel",
              "manifest_digest"
            ]
          }
        ]
      }
    },
    {
      "if": {"properties": {"record_kind": {"const": "semantic_review"}}},
      "then": {
        "required": ["reviewer_id", "payload"],
        "properties": {
          "reviewer_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
          "payload": {
            "type": "object",
            "required": ["author_id", "independent_context", "findings", "view_digest", "context_digest", "mode", "issued_at", "claims"],
            "properties": {
              "author_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "independent_context": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "findings": {"type": "array", "items": {"type": "object"}},
              "view_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "context_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "mode": {"enum": ["local", "merge"]},
              "issued_at": {"type": "number"},
              "claims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["card_id", "claim_id", "status", "reason", "evidence"],
                  "properties": {
                    "card_id": {"type": "string", "minLength": 1},
                    "claim_id": {"type": "string", "minLength": 1},
                    "status": {"enum": ["supported", "unsupported", "retired"]},
                    "reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": ["source_id", "snapshot_id", "locator", "sha256"],
                        "properties": {
                          "source_id": {"type": "string", "minLength": 1},
                          "snapshot_id": {"type": "string", "minLength": 1},
                          "locator": {"type": "object"},
                          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                          "checked_snapshot": {"type": "object"}
                        },
                        "additionalProperties": true
                      }
                    },
                    "verification_evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["requirement", "path", "sha256"],
                        "properties": {
                          "requirement": {"enum": ["build-support", "runtime-support"]},
                          "path": {"type": "string", "minLength": 1},
                          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                        },
                        "additionalProperties": true
                      }
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "source_inventory"
          }
        }
      },
      "then": {
        "required": [
          "scope",
          "full_scan",
          "complete",
          "units"
        ],
        "properties": {
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "full_scan": {
            "type": "boolean"
          },
          "complete": {
            "type": "boolean"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "unit_id",
                "path",
                "source_id",
                "observed_fingerprint",
                "previous_fingerprint",
                "change",
                "read_error",
                "progress"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "ingest_record"
          }
        }
      },
      "then": {
        "required": [
          "scan_ref",
          "scan_digest",
          "dispositions"
        ],
        "properties": {
          "scan_ref": {
            "type": "string",
            "minLength": 1
          },
          "scan_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "dispositions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "unit_id",
                "action",
                "reason",
                "observed_fingerprint",
                "adopted_fingerprint",
                "progress",
                "card_refs",
                "claim_refs"
              ]
            }
          },
          "pending": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "semantic_plan"
          }
        }
      },
      "then": {
        "required": [
          "scan_ref",
          "material_ref",
          "units",
          "card_actions",
          "target_queries"
        ],
        "properties": {
          "units": {
            "type": "array"
          },
          "card_actions": {
            "type": "array"
          },
          "target_queries": {
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "content_review"
          }
        }
      },
      "then": {
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "enum": [
              "passed",
              "failed",
              "incomplete"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_kind": {
            "const": "admission_record"
          }
        }
      },
      "then": {
        "required": [
          "status",
          "batch_kind",
          "view_digest",
          "ingest_record_ref",
          "ingest_record_digest",
          "verification_tier"
        ],
        "properties": {
          "status": {
            "const": "passed"
          },
          "batch_kind": {
            "const": "record_only"
          },
          "view_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "ingest_record_ref": {
            "type": "string",
            "minLength": 1
          },
          "ingest_record_digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verification_tier": {
            "const": "record_only_fixed_validation"
          }
        }
      }
    }
  ]
}
