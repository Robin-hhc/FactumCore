{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HiMate concise Card references with legacy Card/Claim support",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "2.0",
        "3.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "entity",
        "flow",
        "protocol",
        "rule",
        "command",
        "runbook",
        "glossary"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "review_mode": {
      "enum": [
        "code_gate",
        "manual_document"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_ref",
          "source_id",
          "snapshot_id",
          "locator"
        ],
        "properties": {
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "object",
            "minProperties": 1
          },
          "code_ref": {
            "$ref": "#/$defs/code_ref"
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "replacement": {
      "type": [
        "string",
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "deprecation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "search_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "doc_ref": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/doc_reference"
      }
    },
    "code_ref": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/code_reference"
      }
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false,
  "$defs": {
    "code_ref": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "function",
            "struct",
            "class",
            "enum",
            "enum_member",
            "macro",
            "type_alias",
            "variable"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "language": {
          "enum": [
            "c",
            "cpp"
          ]
        },
        "parameter_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "qualifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "const",
              "volatile",
              "&",
              "&&"
            ]
          }
        },
        "role": {
          "enum": [
            "definition",
            "declaration"
          ]
        },
        "form": {
          "enum": [
            "object",
            "function"
          ]
        },
        "parameter_count": {
          "type": "integer",
          "minimum": 0
        },
        "variadic": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "qualifiers"
            ],
            "properties": {
              "qualifiers": {
                "allOf": [
                  {
                    "contains": {
                      "const": "&"
                    }
                  },
                  {
                    "contains": {
                      "const": "&&"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "function"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "form"
                  ]
                },
                {
                  "required": [
                    "parameter_count"
                  ]
                },
                {
                  "required": [
                    "variadic"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "parameter_types"
                  ]
                },
                {
                  "required": [
                    "qualifiers"
                  ]
                },
                {
                  "required": [
                    "role"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "macro"
              }
            }
          },
          "then": {
            "if": {
              "properties": {
                "form": {
                  "const": "object"
                }
              },
              "required": [
                "form"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "parameter_count"
                    ]
                  },
                  {
                    "required": [
                      "variadic"
                    ]
                  }
                ]
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "form"
                  ]
                },
                {
                  "required": [
                    "parameter_count"
                  ]
                },
                {
                  "required": [
                    "variadic"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "chip": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "chip12",
            "chip08",
            "chip07c",
            null
          ]
        },
        "side": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "host",
            "device",
            null
          ]
        },
        "build_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "features_all": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "features_none": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protocol_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revision_policy": {
          "enum": [
            "pinned",
            "revalidate",
            "not_applicable"
          ]
        },
        "pairing_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "context_id",
        "target_id",
        "chip",
        "side",
        "build_profile",
        "features_all",
        "features_none",
        "protocol_versions",
        "revision_policy"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "applicability": {
          "enum": [
            "constrained",
            "universal",
            "unknown"
          ]
        },
        "contexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context"
          }
        }
      },
      "required": [
        "applicability",
        "contexts"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "enum": [
            "normative",
            "design",
            "implementation",
            "measurement",
            "recommendation"
          ]
        },
        "context_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "usage": {
          "enum": [
            "current",
            "historical",
            "guidance"
          ]
        },
        "verification_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "search_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "text_ref",
        "evidence_kind",
        "source_refs",
        "context_ids",
        "usage",
        "verification_requirements"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "requires",
            "derived_from",
            "related_to",
            "replacement"
          ]
        },
        "target_card_id": {
          "type": "string",
          "minLength": 1
        },
        "target_claim_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "type",
        "target_card_id",
        "context_ids"
      ],
      "additionalProperties": false
    },
    "doc_reference": {
      "type": "object",
      "required": [
        "doc_id"
      ],
      "properties": {
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "page_start": {
          "type": "integer",
          "minimum": 1
        },
        "page_end": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "line_start",
            "line_end"
          ]
        },
        {
          "required": [
            "page_start",
            "page_end"
          ]
        },
        {
          "required": [
            "section"
          ]
        }
      ],
      "additionalProperties": false
    },
    "code_reference": {
      "type": "object",
      "required": [
        "code_id",
        "line_start",
        "line_end"
      ],
      "properties": {
        "code_id": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "anyOf": [
    {
      "required": [
        "doc_ref",
        "code_ref"
      ]
    },
    {
      "required": [
        "schema_version",
        "id",
        "profile",
        "title",
        "summary",
        "lifecycle",
        "review_mode",
        "owner",
        "scope",
        "aliases",
        "sources",
        "claims",
        "relations"
      ]
    }
  ]
}
