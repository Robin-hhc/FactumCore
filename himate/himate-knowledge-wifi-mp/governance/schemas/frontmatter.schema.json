{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HiMate complete cards with read-only legacy declarations",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "2.0",
        "3.0"
      ]
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "entity",
        "flow",
        "protocol",
        "rule",
        "command",
        "runbook",
        "glossary"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle": {
      "enum": [
        "draft",
        "stable",
        "deprecated"
      ]
    },
    "review_mode": {
      "enum": [
        "code_gate",
        "manual_document"
      ]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "evidence_ref",
          "source_id",
          "snapshot_id",
          "locator"
        ],
        "properties": {
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "object",
            "minProperties": 1
          },
          "code_ref": {
            "$ref": "#/$defs/code_ref"
          }
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "replacement": {
      "type": [
        "string",
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "deprecation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "search_terms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "doc_ref": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/doc_reference"
      }
    },
    "code_ref": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/code_reference"
      }
    }
  },
  "required": [
    "id"
  ],
  "additionalProperties": false,
  "$defs": {
    "code_ref": {
      "type": "object",
      "required": [
        "kind",
        "name"
      ],
      "properties": {
        "kind": {
          "enum": [
            "function",
            "struct",
            "class",
            "enum",
            "enum_member",
            "macro",
            "type_alias",
            "variable"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "language": {
          "enum": [
            "c",
            "cpp"
          ]
        },
        "parameter_types": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "qualifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "const",
              "volatile",
              "&",
              "&&"
            ]
          }
        },
        "role": {
          "enum": [
            "definition",
            "declaration"
          ]
        },
        "form": {
          "enum": [
            "object",
            "function"
          ]
        },
        "parameter_count": {
          "type": "integer",
          "minimum": 0
        },
        "variadic": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "qualifiers"
            ],
            "properties": {
              "qualifiers": {
                "allOf": [
                  {
                    "contains": {
                      "const": "&"
                    }
                  },
                  {
                    "contains": {
                      "const": "&&"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "function"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "form"
                  ]
                },
                {
                  "required": [
                    "parameter_count"
                  ]
                },
                {
                  "required": [
                    "variadic"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "parameter_types"
                  ]
                },
                {
                  "required": [
                    "qualifiers"
                  ]
                },
                {
                  "required": [
                    "role"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "macro"
              }
            }
          },
          "then": {
            "if": {
              "properties": {
                "form": {
                  "const": "object"
                }
              },
              "required": [
                "form"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "parameter_count"
                    ]
                  },
                  {
                    "required": [
                      "variadic"
                    ]
                  }
                ]
              }
            }
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "form"
                  ]
                },
                {
                  "required": [
                    "parameter_count"
                  ]
                },
                {
                  "required": [
                    "variadic"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "context_id": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "chip": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "chip12",
            "chip08",
            "chip07c",
            null
          ]
        },
        "side": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "host",
            "device",
            null
          ]
        },
        "build_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "features_all": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "features_none": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protocol_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "revision_policy": {
          "enum": [
            "pinned",
            "revalidate",
            "not_applicable"
          ]
        },
        "pairing_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "context_id",
        "target_id",
        "chip",
        "side",
        "build_profile",
        "features_all",
        "features_none",
        "protocol_versions",
        "revision_policy"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "applicability": {
          "enum": [
            "constrained",
            "universal",
            "unknown"
          ]
        },
        "contexts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/context"
          }
        }
      },
      "required": [
        "applicability",
        "contexts"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_kind": {
          "enum": [
            "normative",
            "design",
            "implementation",
            "measurement",
            "recommendation"
          ]
        },
        "context_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "usage": {
          "enum": [
            "current",
            "historical",
            "guidance"
          ]
        },
        "verification_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "search_terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "text_ref",
        "evidence_kind",
        "source_refs",
        "context_ids",
        "usage",
        "verification_requirements"
      ],
      "additionalProperties": false
    },
    "relation": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "requires",
            "derived_from",
            "related_to",
            "replacement"
          ]
        },
        "target_card_id": {
          "type": "string",
          "minLength": 1
        },
        "target_claim_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "type",
        "target_card_id",
        "context_ids"
      ],
      "additionalProperties": false
    },
    "doc_reference": {
      "type": "object",
      "required": [
        "doc_id"
      ],
      "properties": {
        "doc_id": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "page_start": {
          "type": "integer",
          "minimum": 1
        },
        "page_end": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "$ref": "#/$defs/document_locator"
        }
      },
      "anyOf": [
        {
          "required": [
            "line_start",
            "line_end"
          ]
        },
        {
          "required": [
            "page_start",
            "page_end"
          ]
        },
        {
          "required": [
            "section"
          ]
        },
        {
          "required": [
            "locator"
          ]
        }
      ],
      "additionalProperties": false
    },
    "code_reference": {
      "type": "object",
      "required": [
        "code_id",
        "line_start",
        "line_end"
      ],
      "properties": {
        "code_id": {
          "type": "string",
          "minLength": 1
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "selector": {
          "$ref": "#/$defs/code_ref"
        }
      },
      "additionalProperties": false
    },
    "document_locator": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "page",
            "pages",
            "paragraph",
            "paragraphs",
            "table_row",
            "slide",
            "cell_range",
            "element"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "paragraph": {
          "type": "integer",
          "minimum": 1
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "table": {
          "type": "integer",
          "minimum": 1
        },
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "slide": {
          "type": "integer",
          "minimum": 1
        },
        "sheet": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "range": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}[1-9][0-9]{0,6}(:[A-Z]{1,3}[1-9][0-9]{0,6})?$"
        },
        "ref": {
          "type": "string",
          "pattern": "^#/(texts|tables|pictures)/[0-9]+$"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "parser": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pipeline": {
              "enum": [
                "native",
                "standard"
              ]
            },
            "models_path": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^artifacts/models/"
            },
            "ocr_languages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9:_-]{1,40}$"
              }
            },
            "threads": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "timeout_seconds": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 3600
            },
            "max_input_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1
            },
            "max_output_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 268435456
            },
            "images_scale": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4
            }
          }
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "page",
                "pages"
              ]
            }
          },
          "propertyNames": {
            "enum": [
              "kind",
              "page",
              "start",
              "end",
              "number",
              "id"
            ]
          },
          "anyOf": [
            {
              "required": [
                "page"
              ]
            },
            {
              "required": [
                "start"
              ]
            },
            {
              "required": [
                "number"
              ]
            },
            {
              "required": [
                "id"
              ]
            }
          ]
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "paragraph",
                "paragraphs"
              ]
            }
          },
          "propertyNames": {
            "enum": [
              "kind",
              "paragraph",
              "start",
              "end",
              "number",
              "id"
            ]
          },
          "anyOf": [
            {
              "required": [
                "paragraph"
              ]
            },
            {
              "required": [
                "start"
              ]
            },
            {
              "required": [
                "number"
              ]
            },
            {
              "required": [
                "id"
              ]
            }
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "table_row"
            }
          },
          "propertyNames": {
            "enum": [
              "kind",
              "table",
              "row"
            ]
          },
          "required": [
            "table",
            "row"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "slide"
            }
          },
          "propertyNames": {
            "enum": [
              "kind",
              "slide"
            ]
          },
          "required": [
            "slide"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "cell_range"
            }
          },
          "propertyNames": {
            "enum": [
              "kind",
              "sheet",
              "range"
            ]
          },
          "required": [
            "sheet",
            "range"
          ]
        },
        {
          "properties": {
            "kind": {
              "const": "element"
            }
          },
          "propertyNames": {
            "enum": [
              "kind",
              "ref",
              "source_sha256",
              "profile_sha256",
              "parser"
            ]
          },
          "required": [
            "ref",
            "source_sha256",
            "profile_sha256"
          ]
        }
      ]
    }
  },
  "anyOf": [
    {
      "required": [
        "id",
        "doc_ref",
        "code_ref"
      ],
      "propertyNames": {
        "enum": [
          "id",
          "doc_ref",
          "code_ref",
          "tags",
          "lifecycle"
        ]
      },
      "properties": {
        "lifecycle": {
          "enum": [
            "stable",
            "deprecated"
          ]
        },
        "tags": {
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "required": [
        "id",
        "doc_ref",
        "code_ref"
      ],
      "anyOf": [
        {
          "required": [
            "schema_version"
          ]
        },
        {
          "required": [
            "profile"
          ]
        },
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "summary"
          ]
        },
        {
          "required": [
            "review_mode"
          ]
        },
        {
          "required": [
            "owner"
          ]
        },
        {
          "required": [
            "scope"
          ]
        },
        {
          "required": [
            "aliases"
          ]
        },
        {
          "required": [
            "sources"
          ]
        },
        {
          "required": [
            "claims"
          ]
        },
        {
          "required": [
            "relations"
          ]
        },
        {
          "required": [
            "replacement"
          ]
        },
        {
          "required": [
            "deprecation_reason"
          ]
        },
        {
          "required": [
            "search_terms"
          ]
        }
      ]
    },
    {
      "required": [
        "schema_version",
        "id",
        "profile",
        "title",
        "summary",
        "lifecycle",
        "review_mode",
        "owner",
        "scope",
        "aliases",
        "sources",
        "claims",
        "relations"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "doc_ref"
            ]
          },
          {
            "required": [
              "code_ref"
            ]
          }
        ]
      }
    },
    {
      "description": "Read-only compatibility for existing concise draft cards.",
      "required": [
        "id",
        "doc_ref",
        "code_ref",
        "lifecycle"
      ],
      "propertyNames": {
        "enum": [
          "id",
          "doc_ref",
          "code_ref",
          "tags",
          "lifecycle"
        ]
      },
      "properties": {
        "lifecycle": {
          "const": "draft"
        }
      }
    }
  ]
}
