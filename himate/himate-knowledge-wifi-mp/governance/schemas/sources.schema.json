{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "resources",
    "snapshots"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "kind"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "raw",
              "code",
              "attachment"
            ]
          },
          "encoding": {
            "enum": ["utf-8", "gb18030"]
          },
          "processed_hash": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "processed_exists": {
            "type": "boolean"
          },
          "processed_at": {
            "type": "string",
            "minLength": 1
          },
          "source_commit": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{40,64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "snapshot_id",
          "sha256",
          "bytes",
          "recovery"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "recovery": {
            "type": [
              "object",
              "string"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
