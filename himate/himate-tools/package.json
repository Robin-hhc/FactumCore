{
  "name": "@himate/knowledge-cli",
  "version": "0.26.10",
  "description": "HiMate Knowledge CLI launcher",
  "license": "UNLICENSED",
  "bin": {
    "knowledge": "distribution/npm/knowledge.js"
  },
  "files": [
    "distribution/npm/",
    "distribution/source/",
    "knowledge.py",
    "runtime/",
    "docs/DEPLOY.md",
    "docs/NPM-PUBLISH.md",
    ".gitattributes",
    "README.md",
    "!**/__pycache__",
    "!**/.pytest_cache",
    "!**/*.pyc",
    "!**/*.pyo"
  ],
  "scripts": {
    "postinstall": "node distribution/npm/install.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
