# 跨机器运行时，将本文件复制为同目录 config.env，再填写实际连接信息。
# config.env 是本机私有配置，不提交；本文件是随 Skill 分发的模板。
# 配置仅供 Agent/harness 读取，不作为 Shell 脚本执行。

# ssh：通过 harness 连接项目所在服务器；local：在当前机器直接运行。
EXECUTION_MODE=ssh

# SSH 模式需填写服务器主机名、IP 或已有 SSH 别名。
SSH_HOST=

# 可留空，沿用 harness 已有的 SSH 账号设置。
SSH_USER=

# 按服务器实际端口填写。
SSH_PORT=22

# 已有私钥文件的本机路径，可留空沿用已有认证；不要填写私钥正文或密码。
SSH_IDENTITY_FILE=

# SSH 模式需填写服务器原生的项目根路径，该目录包含 AGENTS.md 和 config.yml。
REMOTE_PROJECT_ROOT=

# 实际执行端已有全局 Python 的命令或路径；Linux 常用 python3，Windows 常用 python。
PYTHON=python3
